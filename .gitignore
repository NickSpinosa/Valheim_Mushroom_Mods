# ---- CI scratch ----
# Reference assemblies fetched by .github/workflows/release.yml.
ci-refs/
release-artifacts/

# ---- Build output ----
# No built DLL is committed; releases carry the artifacts.
[Bb]in/
[Oo]bj/
dist/

# ---- Game code (copyrighted - never commit) ----
# Assemblies are referenced from the local Steam install, and fetched by CI
# from the free dedicated server. Vendored copies under Libs/ are not tracked.
Libs/
Libraries/
assembly_*.dll
Assembly-CSharp.dll
UnityEngine*.dll
BepInEx*.dll
0Harmony*.dll

# Decompiled game source. Keep it locally for looking up method names if you
# like - it just must never be committed. Match any casing (Windows).
[Dd]ecompiled/
**/_tmp_decompile/

# ---- Local machine config ----
Directory.Build.user.props
Local.props
*.local.props

# ---- Editors / OS noise ----
.vs/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini
.DS_Store
