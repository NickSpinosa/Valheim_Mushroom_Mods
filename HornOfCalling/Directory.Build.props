<Project>

  <!--
    Per-developer overrides. Create Directory.Build.user.props next to this file to
    point ValheimPath at a non-default install; it is gitignored so it never travels
    with the repo. Imported first so it wins over the defaults below.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <ValheimPath Condition="'$(ValheimPath)' == '' AND Exists('$(HOME)/.local/share/Steam/steamapps/common/Valheim')">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimPath>
    <ValheimPath Condition="'$(ValheimPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimPath>

    <!-- CI supplies ValheimManaged and BepInExCore as global properties, which beat
         these defaults. See docs/devops.md. -->
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(ValheimPath)/valheim_Data/Managed</ValheimManaged>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(ValheimPath)/BepInEx/core</BepInExCore>
    <BepInExPlugins Condition="'$(BepInExPlugins)' == ''">$(ValheimPath)/BepInEx/plugins</BepInExPlugins>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <!--
      MSB3277: netstandard2.1's reference assemblies and Unity's Mono BCL ship
      different System.Net.Http versions. Only Unity's copy exists at runtime, so the
      conflict is noise. Same rationale as vegvisir-compass.
    -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <Target Name="VerifyValheimPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ValheimManaged)/assembly_valheim.dll')"
           Text="Could not find assembly_valheim.dll under '$(ValheimManaged)'. Set ValheimPath in Directory.Build.user.props to your Valheim install directory." />
    <Error Condition="!Exists('$(BepInExCore)/BepInEx.dll')"
           Text="Could not find BepInEx.dll under '$(BepInExCore)'. Install BepInEx into the Valheim folder - see this mod's README." />
  </Target>

</Project>
